# Copy to .env and customize. .env is ignored by git and Docker build contexts.

# --- Account credentials (optional) ---
# Leave empty to train anonymously (CROWDGPT_ANON=1) or reuse a saved token in /data/checkpoints.
# CROWDGPT_USER=your_username
# CROWDGPT_PASSWORD=your_password
# CROWDGPT_TOKEN=

# --- Runtime options ---
# CROWDGPT_BACKEND=auto
# CROWDGPT_ANON=1
# CROWDGPT_VRAM_GB=
# CROWDGPT_ROUNDS=0
# CROWDGPT_ENGRAM=1
# CROWDGPT_NO_UPDATE=1
# CROWDGPT_NO_TOKENIZER=1
# CROWDGPT_NO_TUI=0
# CROWDGPT_DEBUG=0
# CROWDGPT_SERVER=
# CROWDGPT_EXTRA_ARGS=

# --- NVIDIA options ---
# Auto-detected by ./docker/run.sh (falls back to cuda-noruntime when nvidia-container-toolkit is missing).
# Set to 1 to force host driver bind-mounts, or 0 to force nvidia-container-toolkit:
# CROWDGPT_CUDA_NORUNTIME=auto
# CUDA_VISIBLE_DEVICES=0
# For Blackwell / RTX 50-series:
# BASE_IMAGE=pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime

# --- AMD ROCm options ---
# HIP_VISIBLE_DEVICES=0
# ROCR_VISIBLE_DEVICES=0
# Override for consumer Radeon GPUs not officially listed in the ROCm build (e.g. 10.3.0 or 11.0.0):
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# --- Intel XPU options ---
# ONEAPI_DEVICE_SELECTOR=level_zero:0
# ZE_AFFINITY_MASK=0

# --- CPU options ---
# OMP_NUM_THREADS=8
